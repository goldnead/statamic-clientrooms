includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5

    # `config/` is left out on purpose: Larastan flags every `env()` in a file
    # outside the *application's* config directory, and a package config is
    # exactly that. The file is one array literal; `php -l` covers it.
    paths:
        - src
        - routes
        - database

    # Corrects a wrong annotation in Statamic itself, see the stub for why.
    stubFiles:
        - phpstan/AddonServiceProvider.stub

    # The payments addon is a `suggest`, not a `require`: the listener under
    # src/Listeners names its event class in a type hint, and it is not in
    # vendor. Scanned from the test stand-in — the same constructor signature —
    # so the listener is checked against a real shape instead of being
    # reported as an unknown class. Scanned, not analysed: the stand-in is not
    # code this package ships.
    scanFiles:
        - tests/Fakes/payments-event.php

    # A ratchet for new code. The baseline is empty on purpose; keep it that
    # way rather than appending to it.
